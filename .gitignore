# ============================================================
# KG Platform .gitignore
# ============================================================

# ---- 环境变量 / 密钥 ----
.env
*.env.local

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv
*.egg-info/
dist/
build/

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 构建产物 ----
frontend/dist/

# ---- 日志 ----
*.log
uvicorn.log
uvicorn.err.log
vite.log
vite.err.log

# ---- 上传文件 ----
backend/uploads/*
!backend/uploads/.gitkeep

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker ----
.docker/

# ---- 临时文件 ----
*.tmp
*.bak
g6-temp.json

# ---- 测试 / 验证脚本（不提交）----
backend/test_*.py
backend/verify_*.py
backend/check_*.py
backend/reset_pw.py
backend/init_admin.py
verify_*.py
verify_final.py
cleanup_rule.py

# ---- 本地工具配置 ----
.auc/

# ---- 模型文件（太大，不提交）----
download/

# ---- 前端临时文件 ----
install-g6.ps1
uploads/
