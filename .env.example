# ============================================================
# KG Platform 环境变量配置
# ============================================================
# 此文件已填入初始密码，部署到生产环境时请修改为强密码
# ============================================================

# ---- PostgreSQL 数据库 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123
POSTGRES_DB=kg_platform

# ---- Neo4j 图数据库 ----
NEO4J_PASSWORD=admin123

# ---- JWT 认证密钥 ----
JWT_SECRET=admin123

# ---- API Key 加密密钥 ----
ENCRYPTION_KEY=admin123

# ---- CORS 跨域配置 ----
# 生产环境建议设置为你的域名，如: https://kg.example.com
CORS_ORIGINS=*
